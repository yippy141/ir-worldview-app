{
  "name": "ir-worldview-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache",
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:structure && npm run calibrate:modules -- --check && npm run diagnose -- --modules --ai",
    "validate:structure": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/validate-instrument.mts",
    "test": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs --test tests/*.test.mts",
    "test:e2e": "playwright test",
    "copy:audit": "node scripts/audit-public-copy.mjs",
    "copy:audit:strict": "node scripts/audit-public-copy.mjs --strict",
    "evidence:audit": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/evidence-audit.mts",
    "evidence:audit:check": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/evidence-audit.mts --check",
    "tier1:preflight": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/tier1-production-preflight.ts",
    "tier1:verify": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/tier1-production-verify.ts",
    "diagnostics:build-sha": "node scripts/print-build-sha.mjs",
    "calibrate:modules": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/calibrate-modules-bootstrap.mjs",
    "calibrate:targeted": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/calibrate-targeted-forms.mts",
    "diagnose": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/diagnose-instrument.mts",
    "replay:scoring": "node --experimental-strip-types --import ./tests/register-alias-loader.mjs scripts/replay-scoring.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "mapbox-gl": "^3.26.0",
    "next": "16.2.11",
    "next-intl": "^4.13.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "impeccable": "^2.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "picomatch@<=2.3.1": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.5",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.7"
    }
  }
}
