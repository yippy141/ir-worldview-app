diff --git a/components/results/shared-result-notice.tsx b/components/results/shared-result-notice.tsx
new file mode 100644
index 0000000..db216fe
--- /dev/null
+++ b/components/results/shared-result-notice.tsx
@@ -0,0 +1,73 @@
+"use client"
+
+import Link from "next/link"
+import { useSyncExternalStore } from "react"
+import { useLocale } from "next-intl"
+import { browserKnowsFoundationResult, subscribeLocalStorage } from "@/lib/result-ownership"
+import { publicPath } from "@/i18n/paths"
+import type { Locale } from "@/i18n/routing"
+
+type Variant = "shared" | "unknown"
+
+const copy: Record<"en" | "zh-Hans", Record<Variant, { before: string; action: string; after: string }>> = {
+  en: {
+    shared: {
+      before: "You are looking at someone else’s result.",
+      action: "Take the Foundation",
+      after: " to see where you land.",
+    },
+    unknown: {
+      before: "Opened from a link. If this is someone else’s result,",
+      action: "take the Foundation",
+      after: " to see where you land.",
+    },
+  },
+  "zh-Hans": {
+    shared: {
+      before: "这是别人分享的结果。",
+      action: "完成基础问卷",
+      after: "，看看你自己的位置。",
+    },
+    unknown: {
+      before: "此结果来自链接。如果这不是你的结果，可以",
+      action: "完成基础问卷",
+      after: "，看看你自己的位置。",
+    },
+  },
+}
+
+/**
+ * Tells a reader who arrived from a link that the result below belongs to
+ * someone else, and offers the questionnaire. Result copy is written in the
+ * second person for its owner, so a recipient needs this before reading it.
+ */
+export function SharedResultNotice({
+  variant,
+  payload,
+}: {
+  variant: Variant
+  /** When set, the notice hides itself if this browser saved the result. */
+  payload?: string
+}) {
+  const locale = (useLocale() as Locale) === "zh-Hans" ? "zh-Hans" : "en"
+  const text = copy[locale][variant]
+  // An owner opening their own shared link on the same device.
+  const ownResult = useSyncExternalStore(
+    subscribeLocalStorage,
+    () => (payload ? browserKnowsFoundationResult(payload) === true : false),
+    () => false,
+  )
+
+  if (ownResult) return null
+  const gap = locale === "en" ? " " : ""
+  return (
+    <aside className="shared-result-notice" data-shared-result={variant}>
+      <p>
+        {text.before}
+        {gap}
+        <Link href={publicPath(locale, "/quiz")}>{text.action}</Link>
+        {text.after}
+      </p>
+    </aside>
+  )
+}
