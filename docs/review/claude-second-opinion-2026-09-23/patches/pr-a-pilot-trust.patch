@@ -0,0 +1,64 @@
+import { loadProfileStore } from "@/lib/profile-store"
+import { PROFILE_STORAGE_KEY } from "@/lib/storage-keys"
+
+/**
+ * Whether this browser's local Profile holds a Foundation result.
+ *
+ * Returns null when local storage cannot be read, so callers claim nothing
+ * either way. A result is "known" only if it was saved here after a
+ * completion in this browser.
+ */
+export function browserKnowsFoundationResult(payload: string): boolean | null {
+  if (typeof window === "undefined") return null
+  try {
+    if (window.localStorage.getItem(PROFILE_STORAGE_KEY) === null) return false
+  } catch {
+    return null
+  }
+  const store = loadProfileStore()
+  return [store.foundation, ...store.foundationHistory].some(
+    (entry) => entry?.payload === payload,
+  )
+}
+
+/** Query parameter added to links made with the share controls. */
+export const SHARED_VIEW_PARAM = "via"
+export const SHARED_VIEW_VALUE = "share"
+
+export function withSharedView(url: string): string {
+  const separator = url.includes("?") ? "&" : "?"
+  return `${url}${separator}${SHARED_VIEW_PARAM}=${SHARED_VIEW_VALUE}`
+}
+
+/**
+ * What the result page learned about the current reader. Written once by the
+ * save effect and read with useSyncExternalStore, so rendering stays a pure
+ * function of this store.
+ */
+export type ResultOwnership = "unknown" | "saved" | "save-failed" | "opened-from-link"
+
+const ownershipByPayload = new Map<string, ResultOwnership>()
+const ownershipListeners = new Set<() => void>()
+
+export function setResultOwnership(payload: string, ownership: ResultOwnership): void {
+  if (ownershipByPayload.get(payload) === ownership) return
+  ownershipByPayload.set(payload, ownership)
+  for (const listener of ownershipListeners) listener()
+}
+
+export function getResultOwnership(payload: string): ResultOwnership {
+  return ownershipByPayload.get(payload) ?? "unknown"
+}
+
+export function subscribeResultOwnership(listener: () => void): () => void {
+  ownershipListeners.add(listener)
+  return () => {
+    ownershipListeners.delete(listener)
+  }
+}
+
+export function subscribeLocalStorage(listener: () => void): () => void {
+  if (typeof window === "undefined") return () => {}
+  window.addEventListener("storage", listener)
+  return () => window.removeEventListener("storage", listener)
+}
