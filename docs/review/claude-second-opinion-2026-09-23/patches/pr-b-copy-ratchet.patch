+import test from "node:test"
+import assert from "node:assert/strict"
+import { voiceFindings } from "@/scripts/copy-voice-rules.mjs"
+import { compare, summarize, fingerprint } from "@/scripts/copy-ratchet.mjs"
+
+type Candidate = { text: string; index: number; line: number; path: string | null }
+
+function run(fileName: string, texts: Array<string | Candidate>, source = "") {
+  const candidates = texts.map((text, index) =>
+    typeof text === "string" ? { text, index, line: index + 1, path: `k${index}` } : text,
+  )
+  return voiceFindings({
+    fileName,
+    source,
+    candidates,
+    audienceFor: () => "public",
+  }).map((finding: { id: string }) => finding.id)
+}
+
+test("negation-stack flags a sentence that rules things out twice", () => {
+  assert.deepEqual(run("components/results/x.tsx", ["It is not a percentile, and not a margin of error."]), [
+    "negation-stack",
+  ])
+})
+
+test("negation-stack leaves single negation, neither…nor, and quoted option labels alone", () => {
+  assert.deepEqual(run("components/x.tsx", ["Monitoring can keep an agreement alive when trust is thin."]), [])
+  assert.deepEqual(run("components/x.tsx", ["Neither foreign national teams nor the custodian visit the site."]), [])
+  assert.deepEqual(run("components/x.tsx", ["“Not sure” and “None of these” are complete answers here."]), [])
+  assert.deepEqual(run("components/x.tsx", ["button:not([disabled]), input:not([disabled]) and more"]), [])
+})
+
+test("audit-voice flags provenance language in reader copy", () => {
+  assert.ok(run("app/x/page.tsx", ["These are authored reference anchors."]).includes("audit-voice"))
+  assert.ok(run("app/x/page.tsx", ["This page does not claim to measure anything."]).includes("audit-voice"))
+})
+
+test("catalogue-second-person applies to catalogue files only", () => {
+  const gloss = { text: "Your answers put power and timing first.", index: 0, line: 1, path: "records.0.identity.gloss" }
+  assert.deepEqual(run("content/archetypes.json", [gloss]), ["catalogue-second-person"])
+  assert.deepEqual(run("lib/narrative/foundation.ts", [gloss]), [])
+  const question = {
+    text: "When the case hardens, do you still hold several explanations open?",
+    index: 0,
+    line: 1,
+    path: "atlasLitePatterns.0.pressureTestQuestions.0",
+  }
+  assert.deepEqual(run("lib/atlas-lite.ts", [question]), [])
+})
+
+test("metadata paths are skipped", () => {
+  const qualification = {
+    text: "pending human editorial review; no external expert review; no validation claim.",
+    index: 0,
+    line: 1,
+    path: "records.0.content.noticesFirst.qualification",
+  }
+  assert.deepEqual(run("content/archetypes.json", [qualification]), [])
+})
+
+test("internal-label-render flags family labels and technical descriptors in the render layer", () => {
+  const source = "<p>{pattern.technicalDescriptor}</p>\n<span>{familyLabel(key)}</span>"
+  assert.deepEqual(run("components/atlas/card.tsx", [], source), [
+    "internal-label-render",
+    "internal-label-render",
+  ])
+  assert.deepEqual(run("lib/share.ts", [], source), [])
+})
+
+test("explainer rules catch restating and rewriting the item", () => {
+  const restates = JSON.stringify({
+    items: [
+      {
+        prompt: "Recognition from other states rarely changes what governments seek in major security disputes.",
+        clarification: {
+          whatItAsks:
+            "Does recognition from other states have little effect on what governments seek in major security disputes?",
+          terms: [],
+        },
+      },
+    ],
+  })
+  assert.deepEqual(run("content/instrument/foundation.v9.json", [], restates), ["explainer-restates-item"])
+
+  const rewrites = JSON.stringify({
+    items: [
+      {
+        prompt: "A new governing coalition often redirects foreign policy even when the external threat remains unchanged.",
+        clarification: {
+          whatItAsks: "Can elections, leadership changes, and domestic coalitions shift foreign policy as much as events abroad?",
+          terms: [],
+        },
+      },
+    ],
+  })
+  assert.deepEqual(run("content/instrument/foundation.v9.json", [], rewrites), ["explainer-changes-item"])
+})
+
+test("concession-clause-item flags two-condition items", () => {
+  const prompt = {
+    text: "Monitoring can keep agreements alive even when trust is thin.",
+    index: 0,
+    line: 1,
+    path: "items.3.prompt",
+  }
+  assert.deepEqual(run("content/instrument/foundation.v9.json", [prompt]), ["concession-clause-item"])
+})
+
+function finding(rule: string, file: string, source: string, matched = "x") {
+  return { rule, file, source, matched, line: 1, reason: "r", action: "a", audience: "public" }
+}
+
+test("ratchet: editing a locked string makes it a new hit; counted rules only fail on growth", () => {
+  const before = [
+    finding("retired-house-words", "lib/a.ts", "A durable bargain."),
+    finding("rather-than-reflex", "lib/a.ts", "Act rather than wait."),
+  ]
+  const baseline = summarize(before)
+
+  const edited = [
+    finding("retired-house-words", "lib/a.ts", "A durable bargain, kept."),
+    finding("rather-than-reflex", "lib/a.ts", "Act now rather than wait."),
+  ]
+  const result = compare(baseline, summarize(edited), edited)
+  assert.equal(result.regressions.length, 1)
+  assert.equal(result.regressions[0].tier, "locked")
+
+  const grown = [...before, finding("rather-than-reflex", "lib/a.ts", "Lead rather than follow.")]
+  const grownResult = compare(baseline, summarize(grown), grown)
+  assert.equal(grownResult.regressions.length, 1)
+  assert.equal(grownResult.regressions[0].tier, "counted")
+
+  const fixed = [before[1]]
+  const fixedResult = compare(baseline, summarize(fixed), fixed)
+  assert.equal(fixedResult.regressions.length, 0)
+  assert.equal(fixedResult.improvements.locked, 1)
+})
+
+test("ratchet fingerprints ignore file moves and whitespace", () => {
+  assert.equal(
+    fingerprint(finding("audit-voice", "lib/a.ts", "Authored  reference anchors")),
+    fingerprint(finding("audit-voice", "lib/b.ts", "authored reference anchors")),
+  )
+})
