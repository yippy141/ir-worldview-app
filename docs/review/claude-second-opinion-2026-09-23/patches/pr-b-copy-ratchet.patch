+/**
+ * Voice rules for public copy. These catch the patterns the phrase rules in
+ * audit-public-copy.mjs cannot see: stacked negation, audit language shown to
+ * readers, catalogue pages that talk as if the visitor already answered,
+ * internal labels rendered next to public ones, and question explainers that
+ * restate or rewrite the question.
+ *
+ * Each rule returns plain objects. The auditor turns them into findings with
+ * its own structuralFinding() so file, route, audience and context stay
+ * consistent with every other rule.
+ */
+
+import { isContractedArchetypeBetaReference } from "./public-copy-contracts.mjs"
+
+// "neither … nor" is one negation. "without" is left out: it is usually a
+// plain preposition ("act without consent"), not a denial.
+const NEGATOR =
+  /\bneither\b[^.;]{1,80}?\bnor\b|\b(?:not|never|no|none|nothing|cannot|rather than|instead of)\b|\b\w+n[’']t\b/giu
+
+const LOOKS_LIKE_CODE = /:not\(|\[[a-z-]+\]|[{}<>=]|\b\w+\.\w+\(/u
+
+const AUDIT_VOICE =
+  /\bno validation claim\b|\bnot (?:been )?validated\b|\bvalidation has(?: not)? been\b|\bpending (?:human )?(?:editorial )?review\b|\bowner-authori[sz]ed\b|\bAI-assisted\b|\bauthored (?:reference|interpretation|anchor|tradition|reasoning|pattern)s?\b|\breference anchors?\b|\bevidence window\b|\bmeasured population\b|\bno (?:pattern|label|type|archetype) is assigned\b|\bdoes not (?:claim|diagnose|predict|assign|measure|certify)\b|\bis not (?:a|an) (?:diagnosis|prediction|verdict|measurement|test score|personality type|validated)\b|\bnot a (?:diagnosis|prediction|verdict|validated \w+)\b/giu
+
+const READER_RESULT_CLAIM =
+  /\byour (?:answers?|results?|scores?|responses?|profile)\b|\b(?:in )?this result\b|\byou (?:scored|leaned|chose|answered|put)\b/giu
+
+const CONCESSION_CLAUSE = /\beven (?:when|if|during|though|as|where)\b/giu
+
+// Files whose copy is read by visitors who may not have answered anything.
+const CATALOGUE_FILES = [
+  /^content\/archetypes\.json$/,
+  /^lib\/atlas-lite\.ts$/,
+  /^lib\/explore-content\.ts$/,
+  /^content\/explore\//,
+  /^content\/reading\//,
+  /^app\/(?:\[locale\]\/)?(?:archetypes|explore|library)\//,
+  /^components\/atlas\//,
+]
+
+// Per-pattern fields in atlas-lite that are written as questions to the
+// reader. Asking the reader something is fine on a catalogue page.
+const CATALOGUE_READER_QUESTION_PATHS = /pressureTestQuestions/
+
+// Identifiers that carry internal or retired labels. Rendering them in app/ or
+// components/ puts a second name for the same thing on screen.
+const INTERNAL_LABEL_IDENTIFIERS =
+  /\bFAMILY_LABELS\s*\[|\bfamilyLabel\s*\(|\.technicalDescriptor\b|\.originalTechnicalDescriptor\b/gu
+
+const RENDER_LAYER = /^(?:app|components)\//
+
+// Content metadata that is stored with copy but not rendered as reading text.
+const METADATA_PATH = /(?:^|\.)(?:qualification|publicationAuthorization|reviewIds|sourceIds)(?:\.|$)/
+
+const INSTRUMENT_FILE = /^content\/instrument\/(?!schema|foundation\.scoring)[\w.-]+\.json$/
+
+const STOPWORDS = new Set(
+  "a an the and or but of to in on at for from by with as is are was were be been being it its this that these those their there than then when whether which who whom what how do does did can could should would may might will shall into over under about more most less least very so such any some each other another own same not no yes if even usually often state states".split(
+    " ",
+  ),
+)
+
+function words(text) {
+  return text.match(/[A-Za-z][A-Za-z’'-]*/g) ?? []
+}
+
+function contentWords(text) {
+  const byStem = new Map()
+  for (const raw of words(text)) {
+    const word = raw.toLowerCase().replace(/[’']s$/, "")
+    if (word.length <= 3 || STOPWORDS.has(word)) continue
+    if (!byStem.has(stem(word))) byStem.set(stem(word), word)
+  }
+  return byStem
+}
+
+function stem(word) {
+  return word.replace(/(?:ing|ed|es|s|ly)$/u, "")
+}
+
+function sentences(text) {
+  return text
+    .split(/(?<=[.!?])\s+(?=[A-Z“"(])/u)
+    .map((sentence) => sentence.trim())
+    .filter(Boolean)
+}
+
+// Quoted option labels (“Not sure”, “None of these”) are names, not claims.
+function stripQuoted(text) {
+  return text.replace(/“[^”]{1,40}”|"[^"]{1,40}"/gu, "QUOTED")
+}
+
+function isEnglish(text) {
+  const latin = (text.match(/[A-Za-z]/g) ?? []).length
+  const cjk = (text.match(/[㐀-鿿]/g) ?? []).length
+  return latin > 0 && cjk / Math.max(1, latin) < 0.2
+}
+
+/**
+ * @param {object} input
+ * @param {string} input.fileName  repo-relative posix path
+ * @param {string} input.source    file contents
+ * @param {Array<{text:string,index:number,line:number,path:string|null}>} input.candidates
+ * @param {(candidate:object) => string} input.audienceFor
+ * @returns {Array<{candidate:object, id:string, priority:string, kind:string, matched:string, reason:string, action:string}>}
+ */
+export function voiceFindings({ fileName, source, candidates, audienceFor }) {
+  const out = []
+  const isCatalogue = CATALOGUE_FILES.some((pattern) => pattern.test(fileName))
+  const isInstrument = INSTRUMENT_FILE.test(fileName)
+
+  for (const candidate of candidates) {
+    const text = candidate.text
+    if (!isEnglish(text)) continue
+    const audience = audienceFor(candidate)
+    if (audience === "operational" || audience === "editorial-source") continue
+    if (METADATA_PATH.test(candidate.path ?? "")) continue
+
+    // 1. Negation stacked inside one sentence.
+    for (const sentence of LOOKS_LIKE_CODE.test(text) ? [] : sentences(stripQuoted(text))) {
+      const wordCount = words(sentence).length
+      if (wordCount < 6) continue
+      NEGATOR.lastIndex = 0
+      const negators = sentence.match(NEGATOR) ?? []
+      if (negators.length >= 2) {
+        out.push({
+          candidate,
+          id: "negation-stack",
+          priority: "P1",
+          kind: "voice",
+          matched: `${negators.length} negations: ${negators.map((n) => (n.length > 12 ? "neither…nor" : n)).join(", ")} | ${sentence.slice(0, 120)}`,
+          reason:
+            "Two or more negations in one sentence. The reader has to work out what is being ruled out before learning what is true.",
+          action:
+            "Write the positive claim. If a limit is needed, make the claim smaller instead of adding a clause that denies a bigger one.",
+        })
+        break
+      }
+    }
+
+    // 2. Audit and provenance language shown to readers.
+    if (
+      !isContractedArchetypeBetaReference({ text, fileName, path: candidate.path })
+    ) {
+      AUDIT_VOICE.lastIndex = 0
+      let match
+      while ((match = AUDIT_VOICE.exec(text)) !== null) {
+        out.push({
+          candidate,
+          id: "audit-voice",
+          priority: "P1",
+          kind: "voice",
+          matched: match[0],
+          reason:
+            "Review, provenance, or validation language written for the audit trail. Readers see a disclaimer where they expected content.",
+          action:
+            "Delete it, or move one plain sentence about limits to Method. Keep review status in content metadata, not in reader-facing text.",
+        })
+      }
+    }
+
+    // 3. Catalogue copy that assumes the visitor answered.
+    if (isCatalogue && !CATALOGUE_READER_QUESTION_PATHS.test(candidate.path ?? "")) {
+      READER_RESULT_CLAIM.lastIndex = 0
+      let match
+      while ((match = READER_RESULT_CLAIM.exec(text)) !== null) {
+        out.push({
+          candidate,
+          id: "catalogue-second-person",
+          priority: "P1",
+          kind: "voice",
+          matched: match[0],
+          reason:
+            "Catalogue and reference pages are read by people who have not answered. Copy that says “your answers” or “this result” is wrong for them and is also used as the search snippet.",
+          action:
+            "Describe the pattern in the third person (“Kairos puts power and timing first”). Result pages can add the second-person line.",
+        })
+      }
+    }
+
+    // 4. Instrument prompts that carry a concession clause.
+    if (isInstrument && /(?:^|\.)prompt$/.test(candidate.path ?? "")) {
+      CONCESSION_CLAUSE.lastIndex = 0
+      const match = CONCESSION_CLAUSE.exec(text)
+      if (match) {
+        out.push({
+          candidate,
+          id: "concession-clause-item",
+          priority: "P2",
+          kind: "instrument-copy",
+          matched: match[0],
+          reason:
+            "An “even when” clause adds a second condition to the item. Agreeing then means accepting both the claim and the condition.",
+          action:
+            "In the next bank version, state one claim. If the condition is the point, make it the claim.",
+        })
+      }
+    }
+  }
+
+  // 5. Explainers that restate or rewrite the question.
+  if (isInstrument) {
+    out.push(...explainerFindings(fileName, source, candidates, audienceFor))
+  }
+
+  // 6. Internal labels rendered in the UI.
+  if (RENDER_LAYER.test(fileName)) {
+    INTERNAL_LABEL_IDENTIFIERS.lastIndex = 0
+    let match
+    while ((match = INTERNAL_LABEL_IDENTIFIERS.exec(source)) !== null) {
+      const line = source.slice(0, match.index).split("\n").length
+      const lineText = source.split("\n")[line - 1].trim()
+      out.push({
+        candidate: { text: lineText, index: match.index, line, path: "render" },
+        id: "internal-label-render",
+        priority: "P1",
+        kind: "voice",
+        matched: match[0],
+        reason:
+          "This renders an internal or retired label (family label or technical descriptor). Readers then see two names for one thing.",
+        action:
+          "Render the public name only (traditionNounLabel, publicName). Keep internal labels in scoring, payloads, and tests.",
+      })
+    }
+  }
+
+  return out
+}
+
+function explainerFindings(fileName, source, candidates, audienceFor) {
+  const out = []
+  let parsed
+  try {
+    parsed = JSON.parse(source)
+  } catch {
+    return out
+  }
+  const items = Array.isArray(parsed?.items) ? parsed.items : []
+  items.forEach((item, index) => {
+    const prompt = typeof item?.prompt === "string" ? item.prompt : null
+    const explainer = item?.clarification?.whatItAsks
+    if (!prompt || typeof explainer !== "string") return
+    const path = `items.${index}.clarification.whatItAsks`
+    const candidate =
+      candidates.find((entry) => entry.path === path) ?? { text: explainer, index: 0, line: 1, path }
+    if (audienceFor(candidate) === "operational") return
+
+    const promptWords = contentWords(prompt)
+    const explainerWords = contentWords(explainer)
+    const termWords = contentWords(
+      (item.clarification.terms ?? []).map((term) => `${term.term} ${term.definition}`).join(" "),
+    )
+    const shared = [...explainerWords.keys()].filter((word) => promptWords.has(word))
+    const added = [...explainerWords.keys()]
+      .filter((word) => !promptWords.has(word) && !termWords.has(word))
+      .map((word) => explainerWords.get(word))
+    const overlap = shared.length / Math.max(1, explainerWords.size)
+
+    if (overlap >= 0.6) {
+      out.push({
+        candidate,
+        id: "explainer-restates-item",
+        priority: "P2",
+        kind: "instrument-copy",
+        matched: `${Math.round(overlap * 100)}% of the explainer's content words repeat the item`,
+        reason: "The explainer repeats the question in other words, so it adds reading without adding help.",
+        action:
+          "Replace with what agreeing and disagreeing look like, plus any term definition. Do not paraphrase the item.",
+      })
+    } else if (added.length >= 4) {
+      out.push({
+        candidate,
+        id: "explainer-changes-item",
+        priority: "P1",
+        kind: "instrument-copy",
+        matched: `new ideas: ${added.slice(0, 8).join(", ")}`,
+        reason:
+          "The explainer introduces ideas the item does not contain. People who open it answer a different question from people who do not.",
+        action:
+          "In the next bank version, keep the explainer inside the item's claim: agreeing looks like…, disagreeing looks like…, and term definitions.",
+      })
+    }
+  })
+  return out
+}
+
+export const VOICE_RULE_IDS = [
+  "negation-stack",
+  "audit-voice",
+  "catalogue-second-person",
+  "concession-clause-item",
+  "explainer-restates-item",
+  "explainer-changes-item",
+  "internal-label-render",
+]
