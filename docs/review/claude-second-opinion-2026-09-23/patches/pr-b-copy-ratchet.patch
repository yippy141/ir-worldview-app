+#!/usr/bin/env node
+/**
+ * Copy ratchet. Public copy may get better or stay the same. It may not get
+ * worse, and any string you edit has to come out clean on the high-precision
+ * rules.
+ *
+ * Two tiers:
+ *
+ * LOCKED rules are precise enough that every hit is worth fixing. Each hit is
+ * stored as a content fingerprint. Editing a flagged string changes its
+ * fingerprint, so an edited string must pass these rules before CI goes green.
+ * Old untouched strings keep passing until someone touches them. This is how
+ * the backlog drains without a separate rewrite sprint.
+ *
+ * COUNTED rules are useful but noisier. For these, the number of hits per file
+ * and rule may not rise. Edits are free as long as the count does not grow.
+ *
+ * Usage:
+ *   node scripts/copy-ratchet.mjs                 check against the baseline
+ *   node scripts/copy-ratchet.mjs --update        lower the baseline after fixes
+ *   node scripts/copy-ratchet.mjs --update --accept="reason"
+ *                                                  accept new hits, with a reason
+ *   node scripts/copy-ratchet.mjs --report        worst files first, for planning
+ */
+
+import { execFileSync } from "node:child_process"
+import { createHash } from "node:crypto"
+import { readFileSync, writeFileSync, existsSync } from "node:fs"
+import { resolve } from "node:path"
+
+const root = resolve(import.meta.dirname, "..")
+const baselinePath = resolve(root, "scripts/copy-baseline.json")
+const auditPath = resolve(root, "scripts/audit-public-copy.mjs")
+
+export const LOCKED_RULES = new Set([
+  "hard-coded-question-count",
+  "public-release-language",
+  "implementation-detail",
+  "retired-product-history",
+  "banned-contrastive-template",
+  "authored-english-em-dash",
+  "sits-between-template",
+  "keeps-in-play-template",
+  "pulls-clear-template",
+  "you-generally-believe-template",
+  "product-self-narration",
+  "does-not-claim-heading",
+  "ranking-opener-in-option",
+  "retired-house-words",
+  "audit-voice",
+  "catalogue-second-person",
+  "internal-label-render",
+  "explainer-changes-item",
+])
+
+const RATCHETED_AUDIENCES = new Set(["public", "frozen"])
+
+const args = process.argv.slice(2)
+const flag = (name) => args.includes(`--${name}`)
+const option = (name) =>
+  args.find((arg) => arg.startsWith(`--${name}=`))?.slice(name.length + 3) ?? null
+
+function normalize(value) {
+  return String(value ?? "").toLowerCase().replace(/\s+/g, " ").trim()
+}
+
+export function fingerprint(finding) {
+  return createHash("sha1")
+    .update([finding.rule, normalize(finding.source), normalize(finding.matched)].join("\u0000"))
+    .digest("hex")
+    .slice(0, 16)
+}
+
+function runAudit() {
+  const stdout = execFileSync(process.execPath, [auditPath, "--format=json"], {
+    cwd: root,
+    encoding: "utf8",
+    maxBuffer: 128 * 1024 * 1024,
+  })
+  return JSON.parse(stdout).findings.filter((finding) =>
+    RATCHETED_AUDIENCES.has(finding.audience),
+  )
+}
+
+export function summarize(findings) {
+  const locked = {}
+  const counted = {}
+  for (const finding of findings) {
+    if (LOCKED_RULES.has(finding.rule)) {
+      const key = fingerprint(finding)
+      locked[key] ??= {
+        rule: finding.rule,
+        file: finding.file,
+        excerpt: finding.source.slice(0, 90),
+        count: 0,
+      }
+      locked[key].count += 1
+    } else {
+      const key = `${finding.file}::${finding.rule}`
+      counted[key] = (counted[key] ?? 0) + 1
+    }
+  }
+  return { locked: sortObject(locked), counted: sortObject(counted) }
+}
+
+export function compare(baseline, current, findings) {
+  const regressions = []
+  const improvements = { locked: 0, counted: 0 }
+
+  for (const [key, entry] of Object.entries(current.locked)) {
+    const allowed = baseline.locked[key]?.count ?? 0
+    if (entry.count > allowed) {
+      const examples = findings.filter(
+        (finding) => LOCKED_RULES.has(finding.rule) && fingerprint(finding) === key,
+      )
+      regressions.push({ tier: "locked", key, extra: entry.count - allowed, examples })
+    }
+  }
+  for (const [key, count] of Object.entries(current.counted)) {
+    const allowed = baseline.counted[key] ?? 0
+    if (count > allowed) {
+      const [file, rule] = key.split("::")
+      const examples = findings.filter((finding) => finding.file === file && finding.rule === rule)
+      regressions.push({ tier: "counted", key, extra: count - allowed, allowed, count, examples })
+    }
+  }
+  for (const [key, entry] of Object.entries(baseline.locked)) {
+    improvements.locked += Math.max(0, entry.count - (current.locked[key]?.count ?? 0))
+  }
+  for (const [key, count] of Object.entries(baseline.counted)) {
+    improvements.counted += Math.max(0, count - (current.counted[key] ?? 0))
+  }
+  return { regressions, improvements }
+}
+
+function sortObject(object) {
+  return Object.fromEntries(Object.entries(object).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)))
+}
+
+function loadBaseline() {
+  if (!existsSync(baselinePath)) return null
+  return JSON.parse(readFileSync(baselinePath, "utf8"))
+}
+
+function writeBaseline(summary, previous, acceptance) {
+  const acceptances = previous?.acceptances ?? []
+  if (acceptance) acceptances.push(acceptance)
+  const body = {
+    schema: 1,
+    note:
+      "Generated by scripts/copy-ratchet.mjs --update. Counts may only fall. Raise them only with --accept and a reason.",
+    totals: {
+      locked: Object.values(summary.locked).reduce((sum, entry) => sum + entry.count, 0),
+      counted: Object.values(summary.counted).reduce((sum, count) => sum + count, 0),
+    },
+    acceptances,
+    locked: summary.locked,
+    counted: summary.counted,
+  }
+  writeFileSync(baselinePath, `${JSON.stringify(body, null, 2)}\n`)
+  return body.totals
+}
+
+function printRegression(regression) {
+  const first = regression.examples[0]
+  if (regression.tier === "locked") {
+    for (const example of regression.examples.slice(0, regression.extra)) {
+      console.log(`\n  ${example.file}:${example.line}  [${example.rule}]`)
+      console.log(`    “${example.source.slice(0, 200)}”`)
+      console.log(`    matched: ${example.matched}`)
+      console.log(`    why: ${example.reason}`)
+      console.log(`    fix: ${example.action}`)
+    }
+  } else {
+    console.log(`\n  ${regression.key}: ${regression.allowed} → ${regression.count}`)
+    if (first) {
+      console.log(`    why: ${first.reason}`)
+      console.log(`    fix: ${first.action}`)
+      for (const example of regression.examples.slice(0, 4)) {
+        console.log(`    - line ${example.line}: ${example.matched.slice(0, 120)}`)
+      }
+    }
+  }
+}
+
+function report(findings) {
+  const byFile = new Map()
+  for (const finding of findings) {
+    const entry = byFile.get(finding.file) ?? { total: 0, locked: 0, rules: new Map() }
+    entry.total += 1
+    if (LOCKED_RULES.has(finding.rule)) entry.locked += 1
+    entry.rules.set(finding.rule, (entry.rules.get(finding.rule) ?? 0) + 1)
+    byFile.set(finding.file, entry)
+  }
+  const rows = [...byFile.entries()].sort((a, b) => b[1].locked - a[1].locked || b[1].total - a[1].total)
+  console.log("file | locked | total | top rules")
+  for (const [file, entry] of rows.slice(0, 40)) {
+    const top = [...entry.rules.entries()]
+      .sort((a, b) => b[1] - a[1])
+      .slice(0, 3)
+      .map(([rule, count]) => `${rule} ${count}`)
+      .join(", ")
+    console.log(`${file} | ${entry.locked} | ${entry.total} | ${top}`)
+  }
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const findings = runAudit()
+  const current = summarize(findings)
+  const baseline = loadBaseline()
+
+  if (flag("report")) {
+    report(findings)
+    process.exit(0)
+  }
+
+  if (!baseline) {
+    if (!flag("update")) {
+      console.error("No scripts/copy-baseline.json. Run with --update once to create it.")
+      process.exit(1)
+    }
+    const totals = writeBaseline(current, null, null)
+    console.log(`Created copy baseline: ${totals.locked} locked, ${totals.counted} counted.`)
+    process.exit(0)
+  }
+
+  const { regressions, improvements } = compare(baseline, current, findings)
+
+  if (flag("update")) {
+    const reason = option("accept")
+    if (regressions.length && !reason) {
+      console.error(
+        `${regressions.length} regressions. Fix them, or run --update --accept="why these are acceptable".`,
+      )
+      for (const regression of regressions) printRegression(regression)
+      process.exit(1)
+    }
+    const acceptance = regressions.length
+      ? {
+          date: new Date().toISOString().slice(0, 10),
+          reason,
+          added: regressions.reduce((sum, regression) => sum + regression.extra, 0),
+        }
+      : null
+    const totals = writeBaseline(current, baseline, acceptance)
+    console.log(
+      `Baseline updated: ${totals.locked} locked, ${totals.counted} counted` +
+        ` (${improvements.locked + improvements.counted} fewer than before).`,
+    )
+    process.exit(0)
+  }
+
+  if (regressions.length) {
+    console.log(`Copy ratchet: ${regressions.length} regression(s). Public copy got worse here:`)
+    for (const regression of regressions) printRegression(regression)
+    console.log(
+      "\nEdited strings must pass the locked rules. See IR_EDITORIAL_STYLE_GUIDE.md and docs/voice/VOICE.md.",
+    )
+    process.exitCode = 1
+  } else {
+    const fixed = improvements.locked + improvements.counted
+    console.log(
+      `Copy ratchet: no regressions.${fixed ? ` ${fixed} fewer hits than the baseline; run npm run copy:ratchet:update to lock that in.` : ""}`,
+    )
+  }
+}
